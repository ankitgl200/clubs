# ==============================================================================
# CLUB COLLECTION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Environment Mode: 'development' (uses Localhost MongoDB) or 'production' (uses MongoDB Atlas)
NODE_ENV=development

# Explicit Override (Optional): 'local' or 'atlas'
MONGODB_MODE=local

# Localhost MongoDB (Used automatically during development)
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/club_studymyte

# MongoDB Atlas Cloud (Used automatically in production)
ATLAS_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/club_studymyte?retryWrites=true&w=majority

# Fallback URI
MONGODB_URI=mongodb://127.0.0.1:27017/club_studymyte

# Port & JWT Secret
PORT=5000
JWT_SECRET=your_secure_jwt_secret_key_here

# Cloudinary (Profile Avatars, Club Media & PDFs)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=club_avatars

# Backend API URL for frontend
VITE_API_URL=http://localhost:5000/api
VITE_APP_URL=http://localhost:5173
